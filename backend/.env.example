# MSRTC NextGen — Backend Environment
# Copy to .env and fill in values

# Server
PORT=3000
NODE_ENV=development

# JWT Authentication (required — use a strong random secret in production)
JWT_SECRET=msrtc_secure_jwt_token_key_2026

# HMAC secret for e-ticket QR signing (required — use a strong random secret in production)
HMAC_SECRET=msrtc_hmac_sha256_e_ticket_secret_key_2026

# Google Gemini AI — optional; ST-Mitra falls back to rule engine if unset
GEMINI_API_KEY=

# Application base URL (used for CORS)
APP_URL=http://localhost:3000
